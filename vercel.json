{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        { "src": "/api/.*", "dest": "server.js" },
        { "src": "/files/.*", "dest": "server.js" },
        {
            "src": "/api/files",
            "dest": "server.js"
        },
        {
            "src": "/api/send",
            "dest": "server.js"
        },
        {
            "src": "/files/(.*)",
            "dest": "server.js"
        },
        {
            "src": "/files/download/(.*)",
            "dest": "server.js"
        }
    ]
}